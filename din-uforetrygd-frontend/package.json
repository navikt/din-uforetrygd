{
  "name": "uforetrygd-frontend",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts\" \"next dev --turbopack\"",
    "dev:avsluttet": "MOCK_SCENARIO=avsluttet concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts avsluttet\" \"next dev --turbopack --port 3001\"",
    "dev:forbidden": "MOCK_SCENARIO=forbidden concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts forbidden\" \"next dev --turbopack --port 3002\"",
    "dev:gradert": "MOCK_SCENARIO=gradert concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts gradert\" \"next dev --turbopack --port 3003\"",
    "dev:lopende": "MOCK_SCENARIO=har-lopende concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts har-lopende\" \"next dev --turbopack --port 3004\"",
    "dev:sak-behandling": "MOCK_SCENARIO=sak-behandling concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts sak-behandling\" \"next dev --turbopack --port 3005\"",
    "dev:ufore-behandling": "MOCK_SCENARIO=ufore-behandling concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts ufore-behandling\" \"next dev --turbopack --port 3006\"",
    "dev:ingen-uforesak": "MOCK_SCENARIO=ingen-uforesak concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts ingen-uforesak\" \"next dev --turbopack --port 3007\"",
    "dev:ufore-uten-datoer": "MOCK_SCENARIO=ufore-uten-datoer concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts ufore-uten-datoer\" \"next dev --turbopack --port 3008\"",
    "dev:all": "concurrently --kill-others-on-fail --success=first \"bun mock/serverDynamic.ts\" \"npm run dev\" \"npm run dev:avsluttet\" \"npm run dev:forbidden\" \"npm run dev:gradert\" \"npm run dev:lopende\" \"npm run dev:sak-behandling\" \"npm run dev:ufore-behandling\" \"npm run dev:ingen-uforesak\" \"npm run dev:ufore-uten-datoer\"",
    "build": "npm run test && next build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest --run ",
    "test:playwright": "playwright test",
    "types:generate": "openapi-typescript https://uforetrygd-backend.intern.dev.nav.no/v3/api-docs -o src/api/api.d.ts",
    "prettier:check": "prettier --check '**/*.{cjs,js,jsx,ts,tsx,json}'",
    "prettier:fix": "prettier --write '**/*.{cjs,js,jsx,ts,tsx,json}'"
  },
  "dependencies": {
    "@elastic/ecs-winston-format": "^1.5.3",
    "@navikt/aksel-icons": "^7.32.1",
    "@navikt/ds-css": "^7.32.1",
    "@navikt/ds-react": "^7.32.1",
    "@navikt/nav-dekoratoren-moduler": "~3.4.0",
    "@navikt/oasis": "^3.4.0",
    "@navikt/steng-for-regulering": "^0.0.7",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "express": "^5.1.0",
    "form-data": "~4.0.4",
    "next": "15.5.4",
    "openapi-fetch": "^0.14.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^24.6.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.0",
    "bun": "^1.2.23",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "eslint": "^9.37.0",
    "eslint-config-next": "15.5.4",
    "eslint-config-prettier": "^10.1.8",
    "openapi-typescript": "^7.9.0",
    "prettier": "^3.6.2",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "jose": "^6.0.12"
  }
}
