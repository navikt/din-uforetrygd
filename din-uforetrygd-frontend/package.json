{
  "name": "din-uforetrygd-frontend",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"node --env-file=.env.local server/server.ts \"",
    "mock": "ENABLE_MSW=true next dev",
    "mock:playwright": "ENABLE_MSW=true next dev --port 3000",
    "mock:uforesak": "ENABLE_MSW=true MOCK_SCENARIO=default next dev --port 3000",
    "mock:avsluttet": "ENABLE_MSW=true MOCK_SCENARIO=avsluttet next dev --port 3001",
    "mock:veileder": "ENABLE_MSW=true MODE=veileder next dev --port 3002",
    "mock:gradert": "ENABLE_MSW=true MOCK_SCENARIO=gradert next dev --port 3003",
    "mock:lopende": "ENABLE_MSW=true MOCK_SCENARIO=har-lopende next dev --port 3004",
    "mock:sak-behandling": "ENABLE_MSW=true MOCK_SCENARIO=sak-behandling next dev --port 3005",
    "mock:ufore-behandling": "ENABLE_MSW=true MOCK_SCENARIO=ufore-behandling next dev --port 3006",
    "mock:ingen-uforesak": "ENABLE_MSW=true MOCK_SCENARIO=ingen-uforesak next dev --port 3007",
    "mock:ufore-uten-datoer": "ENABLE_MSW=true MOCK_SCENARIO=ufore-uten-datoer next dev --port 3008",
    "mock:forbidden": "ENABLE_MSW=true MOCK_SCENARIO=forbidden next dev --port 3009",
    "build": "npm run test && next build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "next start",
    "check": "biome check src/ --max-diagnostics=none ; tsc --noEmit",
    "fix": "biome check --write src/ --max-diagnostics=none",
    "test": "vitest --run ",
    "test:playwright": "playwright test",
    "test:playwright:uforesak": "playwright test tests/uforetrygd-mock-uforesak.spec.ts",
    "test:playwright:avsluttet": "playwright test tests/uforetrygd-mock-avsluttet.spec.ts",
    "test:playwright:forbidden": "playwright test tests/uforetrygd-mock-forbidden.spec.ts",
    "test:playwright:gradert": "playwright test tests/uforetrygd-mock-gradert.spec.ts",
    "test:playwright:lopende": "playwright test tests/uforetrygd-mock-lopende-uten-vedtak.spec.ts",
    "test:playwright:sak-behandling": "playwright test tests/uforetrygd-mock-sak-til-behandling-ingen-ufore.spec.ts",
    "test:playwright:ufore-behandling": "playwright test tests/uforetrygd-mock-ufore-og-behandling.spec.ts",
    "test:playwright:ingen-uforesak": "playwright test tests/uforetrygd-mock-ingen-uforesak.spec.ts",
    "test:playwright:ufore-uten-datoer": "playwright test tests/uforetrygd-mock-ufore-uten-datoer.spec.ts"
  },
  "dependencies": {
    "@elastic/ecs-winston-format": "^1.5.3",
    "@grafana/faro-web-sdk": "^2.11.0",
    "@highcharts/react": "^5.3.0",
    "@navikt/aksel-icons": "^8.16.1",
    "@navikt/ds-css": "^8.16.1",
    "@navikt/ds-react": "^8.16.1",
    "@navikt/nav-dekoratoren-moduler": "~4.2.2",
    "@navikt/oasis": "^4.1.4",
    "@navikt/steng-for-regulering": "^0.0.7",
    "@unleash/nextjs": "^1.6.7",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "form-data": "~4.0.6",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "unleash-client": "^6.12.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.62.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "bun": "^1.4.0",
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "msw": "^2.15.0",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "jose": "^6.0.12"
  }
}
