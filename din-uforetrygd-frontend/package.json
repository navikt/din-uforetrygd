{
  "name": "uforetrygd-frontend",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail  \"next dev --turbopack\" \"bun mock/server.ts\"",
    "build": "npm run test && next build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest --run",
    "types:generate": "openapi-typescript https://uforetrygd-backend.intern.dev.nav.no/v3/api-docs -o src/api/api.d.ts",
    "prettier:check": "prettier --check '**/*.{cjs,js,jsx,ts,tsx,json}'",
    "prettier:fix": "prettier --write '**/*.{cjs,js,jsx,ts,tsx,json}'"
  },
  "dependencies": {
    "@elastic/ecs-winston-format": "^1.5.3",
    "@navikt/aksel-icons": "^7.25.1",
    "@navikt/ds-css": "^7.25.1",
    "@navikt/ds-react": "^7.25.1",
    "@navikt/nav-dekoratoren-moduler": "~3.4.0",
    "@navikt/oasis": "^3.4.0",
    "@navikt/steng-for-regulering": "^0.0.7",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "express": "^5.1.0",
    "form-data": "~4.0.4",
    "next": "15.5.0",
    "openapi-fetch": "^0.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "bun": "^1.2.20",
    "concurrently": "^9.2.0",
    "cors": "^2.8.5",
    "eslint": "^9.33.0",
    "eslint-config-next": "15.5.0",
    "eslint-config-prettier": "^10.1.8",
    "openapi-typescript": "^7.9.0",
    "prettier": "^3.6.2",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "jose": "^6.0.12"
  }
}
