{
  "name": "din-uforetrygd-frontend",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "local": "concurrently --kill-others-on-fail \"node server/server.ts \"",
    "dev": "concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts\" \"next dev\"",
    "dev:avsluttet": "MOCK_SCENARIO=avsluttet concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts avsluttet\" \"next dev --port 3001\"",
    "dev:forbidden": "MOCK_SCENARIO=forbidden concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts forbidden\" \"next dev --port 3002\"",
    "dev:gradert": "MOCK_SCENARIO=gradert concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts gradert\" \"next dev --port 3003\"",
    "dev:lopende": "MOCK_SCENARIO=har-lopende concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts har-lopende\" \"next dev --port 3004\"",
    "dev:sak-behandling": "MOCK_SCENARIO=sak-behandling concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts sak-behandling\" \"next dev --port 3005\"",
    "dev:ufore-behandling": "MOCK_SCENARIO=ufore-behandling concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts ufore-behandling\" \"next dev --port 3006\"",
    "dev:ingen-uforesak": "MOCK_SCENARIO=ingen-uforesak concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts ingen-uforesak\" \"next dev --port 3007\"",
    "dev:ufore-uten-datoer": "MOCK_SCENARIO=ufore-uten-datoer concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts ufore-uten-datoer\" \"next dev --port 3008\"",
    "dev:all": "concurrently --kill-others-on-fail --success=first \"bun mock/serverDynamic.ts\" \"npm run dev\" \"npm run dev:avsluttet\" \"npm run dev:forbidden\" \"npm run dev:gradert\" \"npm run dev:lopende\" \"npm run dev:sak-behandling\" \"npm run dev:ufore-behandling\" \"npm run dev:ingen-uforesak\" \"npm run dev:ufore-uten-datoer\"",
    "build": "npm run test && next build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "next start",
    "check": "eslint src/ ; biome check src/ ; tsc --noEmit",
    "fix": "eslint src/ --fix ; biome check --write src/ --max-diagnostics=none",
    "test": "vitest --run ",
    "test:playwright": "playwright test",
    "types:generate": "openapi-typescript https://din-uforetrygd-backend.intern.dev.nav.no/v3/api-docs -o src/api/api.d.ts"
  },
  "dependencies": {
    "@elastic/ecs-winston-format": "^1.5.3",
    "@grafana/faro-web-sdk": "^2.3.1",
    "@navikt/aksel-icons": "^8.8.0",
    "@navikt/ds-css": "^8.8.0",
    "@navikt/ds-react": "^8.8.0",
    "@navikt/nav-dekoratoren-moduler": "~3.6.3",
    "@navikt/oasis": "^4.1.4",
    "@navikt/steng-for-regulering": "^0.0.7",
    "@unleash/nextjs": "^1.6.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "form-data": "~4.0.5",
    "next": "^16.2.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@eslint/compat": "^2.0.3",
    "@next/eslint-plugin-next": "^16.2.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.57.2",
    "bun": "^1.3.11",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "jose": "^6.0.12",
    "eslint-plugin-react-hooks": {
      "eslint": "$eslint"
    }
  }
}
