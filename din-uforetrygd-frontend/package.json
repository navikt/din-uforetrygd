{
  "name": "din-uforetrygd-frontend",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "local": "concurrently --kill-others-on-fail \"node --env-file=.env.local server/server.ts \"",
    "dev": "concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts\" \"next dev\"",
    "dev:playwright": "concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts\" \"next dev --port 3000\"",
    "dev:veileder": "MODE=veileder concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts\" \"next dev --port 3002\"",
    "dev:uforesak": "MOCK_SCENARIO=default concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts\" \" next dev --port 3000\"",
    "dev:avsluttet": "MOCK_SCENARIO=avsluttet concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts\" \"next dev --port 3001\"",
    "dev:forbidden": "MOCK_SCENARIO=forbidden concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts\" \"next dev --port 3002\"",
    "dev:gradert": "MOCK_SCENARIO=gradert concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts\" \"next dev --port 3003\"",
    "dev:lopende": "MOCK_SCENARIO=har-lopende concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts\" \"next dev --port 3004\"",
    "dev:sak-behandling": "MOCK_SCENARIO=sak-behandling concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts\" \"next dev --port 3005\"",
    "dev:ufore-behandling": "MOCK_SCENARIO=ufore-behandling concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts\" \"next dev --port 3006\"",
    "dev:ingen-uforesak": "MOCK_SCENARIO=ingen-uforesak concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts\" \"next dev --port 3007\"",
    "dev:ufore-uten-datoer": "MOCK_SCENARIO=ufore-uten-datoer concurrently --kill-others-on-fail \"bun mock/serverDynamic.ts\" \"next dev --port 3008\"",
    "dev:all": "npm run dev",
    "build": "npm run test && next build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "next start",
    "check": "eslint src/ ; biome check src/ ; tsc --noEmit",
    "fix": "eslint src/ --fix ; biome check --write src/ --max-diagnostics=none",
    "test": "vitest --run ",
    "test:playwright": "playwright test",
    "test:playwright:uforesak": "playwright test tests/uforetrygd-mock-uforesak.spec.ts",
    "test:playwright:avsluttet": "playwright test tests/uforetrygd-mock-avsluttet.spec.ts",
    "test:playwright:forbidden": "playwright test tests/uforetrygd-mock-forbidden.spec.ts",
    "test:playwright:gradert": "playwright test tests/uforetrygd-mock-gradert.spec.ts",
    "test:playwright:lopende": "playwright test tests/uforetrygd-mock-lopende-uten-vedtak.spec.ts",
    "test:playwright:sak-behandling": "playwright test tests/uforetrygd-mock-sak-til-behandling-ingen-ufore.spec.ts",
    "test:playwright:ufore-behandling": "playwright test tests/uforetrygd-mock-ufore-og-behandling.spec.ts",
    "test:playwright:ingen-uforesak": "playwright test tests/uforetrygd-mock-ingen-uforesak.spec.ts",
    "test:playwright:ufore-uten-datoer": "playwright test tests/uforetrygd-mock-ufore-uten-datoer.spec.ts"
  },
  "dependencies": {
    "@elastic/ecs-winston-format": "^1.5.3",
    "@grafana/faro-web-sdk": "^2.7.1",
    "@highcharts/react": "^5.1.0",
    "@navikt/aksel-icons": "^8.13.0",
    "@navikt/ds-css": "^8.13.0",
    "@navikt/ds-react": "^8.13.0",
    "@navikt/nav-dekoratoren-moduler": "~4.2.2",
    "@navikt/oasis": "^4.1.4",
    "@navikt/steng-for-regulering": "^0.0.7",
    "@unleash/nextjs": "^1.6.7",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "form-data": "~4.0.6",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "unleash-client": "^6.11.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@eslint/compat": "^2.1.0",
    "@next/eslint-plugin-next": "^16.2.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.61.1",
    "bun": "^1.3.14",
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.4",
    "typescript": "^6",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "jose": "^6.0.12",
    "eslint-plugin-react-hooks": {
      "eslint": "$eslint"
    }
  }
}
