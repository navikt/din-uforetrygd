{
  "compilerOptions": {
    "module": "ES2020",
    "target": "ES2024",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "rootDir": "server",
    "outDir": "dist"
  },
  "include": ["server/**/*.ts"],
  "exclude": ["node_modules"]
}
