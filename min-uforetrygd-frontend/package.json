{
  "name": "uforetrygd-frontend",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail  \"next dev --turbopack\" \"bun mock/server.ts\"",
    "build": "npm run test && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest --run",
    "types:generate": "openapi-typescript https://uforetrygd-backend.intern.dev.nav.no/v3/api-docs -o src/api/api.d.ts",
    "prettier:check": "prettier --check '**/*.{cjs,js,jsx,ts,tsx,json}'",
    "prettier:fix": "prettier --write '**/*.{cjs,js,jsx,ts,tsx,json}'"
  },
  "dependencies": {
    "@elastic/ecs-winston-format": "^1.5.3",
    "@navikt/aksel-icons": "^7.8.0",
    "@navikt/ds-css": "^7.6.0",
    "@navikt/ds-react": "^7.8.0",
    "@navikt/nav-dekoratoren-moduler": "^3.1.1",
    "@navikt/oasis": "^3.4.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "next": "15.0.3",
    "openapi-fetch": "^0.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "bun": "^1.1.38",
    "concurrently": "^9.1.0",
    "cors": "^2.8.5",
    "eslint": "^8",
    "eslint-config-next": "15.0.3",
    "eslint-config-prettier": "^9.1.0",
    "express": "^4.21.1",
    "openapi-typescript": "^7.4.3",
    "prettier": "^3.4.1",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.3",
    "vitest": "^2.1.8"
  }
}
